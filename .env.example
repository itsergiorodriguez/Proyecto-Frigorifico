# Motor de datos:  file (por defecto, sin instalar nada)  |  pg (PostgreSQL, escalable)
DB_DRIVER=file

# Puerto del servidor
PORT=3000

# Solo si DB_DRIVER=pg  (PostgreSQL):
# DATABASE_URL=postgres://usuario:clave@localhost:5432/salamaquinas

# En producción (hosting con HTTPS): habilita redirect a HTTPS, cookies "Secure"
# y cabeceras de seguridad adicionales.
# NODE_ENV=production
